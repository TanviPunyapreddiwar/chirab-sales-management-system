DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chirab_sales
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Storage configuration: local | s3 | azure | cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Cloudinary (used for persistent document storage on Railway and production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (optional, for future use)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Azure Blob Storage (optional, for future use)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Email configuration: none | smtp | sendgrid
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@chirabtechnologies.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
